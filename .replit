modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "intent-routing-smoke"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "onboarding-demo-browser"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "agent-catalogue-setup"

[[workflows.workflow]]
name = "intent-routing-smoke"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "NODE_ENV=development artifacts/onboarding-agent/node_modules/.bin/tsx scripts/isolated-intent-smoke.mjs"

[[workflows.workflow]]
name = "onboarding-demo-browser"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm test:browser-regression"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "agent-catalogue-setup"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run test:agent-catalogue && pnpm run typecheck"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[nix]
channel = "stable-25_05"
packages = ["alsa-lib", "at-spi2-atk", "atk", "cairo", "cups", "dbus", "freetype", "glib", "glibcLocales", "gumbo", "harfbuzz", "jbig2dec", "libgbm", "libjpeg_turbo", "libxkbcommon", "mesa", "mupdf", "nspr", "nss", "openjpeg", "pango", "swig", "xcbuild", "xorg.libX11", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXext", "xorg.libXfixes", "xorg.libXrandr", "xorg.libxcb", "clamav"]

[userenv]

[userenv.shared]
ONBOARDING_ALLOWED_RECIPIENTS = "helkiah@gmail.com,manojsamuel.helkiah@hcltech.com"

[userenv.development]
MALWARE_SCANNER_CLAMAV_SOCKET_PATH = "/tmp/hro-private-document-scanner/clamd.sock"
MALWARE_SCANNER_CLAMAV_TIMEZONE = "UTC"

[objectStorage]
defaultBucketID = "replit-objstore-b03aae0f-24bc-4583-a731-9788c26e9a34"
