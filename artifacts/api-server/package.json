{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -b tsconfig.json",
    "test": "node ./run-tests.mjs",
    "db:reconcile": "node ./test-db-setup.mjs",
    "db:migrate:reviewed": "node ./run-reviewed-migration.mjs",
    "seed:volunteers": "node ./run-seed.mjs"
  },
  "dependencies": {
    "@clerk/express": "^2.1.55",
    "@clerk/shared": "^4.28.1",
    "@google-cloud/storage": "^7.16.0",
    "@replit/connectors-sdk": "^0.4.2",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/integrations-openai-ai-server": "workspace:*",
    "@workspace/pricing-model": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "http-proxy-middleware": "^4.2.0",
    "multer": "^2.2.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "catalog:",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pg": "^8.22.0",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
