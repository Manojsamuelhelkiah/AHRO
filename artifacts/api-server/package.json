{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "start:production": "node --enable-source-maps ./start-production.mjs",
    "typecheck": "tsc -b tsconfig.json",
    "validate:routes": "tsc -b tsconfig.json --pretty false",
    "test": "pnpm run test:policy-quality && pnpm run test:post-merge && node ./run-tests.mjs",
    "test:policy-quality": "node ./test-policy-quality.mjs",
    "test:post-merge": "bash ../../scripts/post-merge.test.sh",
    "test:workspace-cleanup": "NODE_ENV=test node --test workspace-cleanup.test.mjs",
    "workspaces:inventory": "node clean-disposable-workspaces.mjs --dry-run",
    "db:reconcile": "node ./test-db-setup.mjs",
    "db:migrate:reviewed": "node ./run-reviewed-migration.mjs",
    "authority:governance:approve": "node ./approve-authority-governance.mjs",
    "admin:private": "node ./run-private-admin.mjs",
    "db:verify:tenant-safeguards": "node ./verify-tenant-safeguards.mjs",
    "seed:demo-full-coverage": "SEED_SCRIPT=src/scripts/seed-demo-full-coverage.ts node ./run-seed.mjs",
    "probe:malware-scanner": "pnpm exec esbuild src/scripts/malware-scanner-probe.ts --bundle --platform=node --format=esm --target=node20 --log-level=error --outfile=.malware-scanner-probe.mjs && (node .malware-scanner-probe.mjs; status=$?; rm -f .malware-scanner-probe.mjs; exit $status)"
  },
  "dependencies": {
    "@clerk/express": "^2.1.55",
    "@clerk/shared": "^4.28.1",
    "@google-cloud/storage": "^7.16.0",
    "@replit/connectors-sdk": "^0.4.2",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/integrations-openai-ai-server": "workspace:*",
    "@workspace/pricing-model": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "http-proxy-middleware": "^4.2.0",
    "mammoth": "^1.13.0",
    "multer": "^2.2.0",
    "pdf-parse": "^2.4.5",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "word-extractor": "^1.0.4",
    "yauzl": "^3.4.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "@types/yauzl": "^3.4.0",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pg": "^8.22.0",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
